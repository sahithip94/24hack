# Copy this file to .env and replace SECRET_KEY with a long random secret.
SECRET_KEY=replace-this-with-a-long-random-secret-before-running
DATABASE_URL=sqlite:///./lost_in_transit.db
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
ACCESS_TOKEN_MINUTES=60
FRONTEND_URL=http://localhost:5173
# FRONTEND_BASE_URL is still honoured as a fallback for FRONTEND_URL.
# FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional LLM for /summary/generate. Either provider works; without a real key
# a clearly labelled local fallback summary is returned.
#   Google Gemini (recommended) - create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model tried first. If it is retired or has hit its per-model daily quota, the
# backend automatically falls back to other current Gemini models.
GEMINI_MODEL=gemini-3.5-flash
#   Any OpenAI-compatible endpoint:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=

# -------------------- OCR (image text extraction) --------------------
# Image OCR uses Tesseract through the Python pytesseract package. Installing
# the Python package is not enough on its own: the Tesseract application must
# also be installed and reachable. See OCR_SETUP.md for detailed steps.
#
# Windows: install with `winget install UB-Mannheim.TesseractOCR` or the
# installer from https://github.com/UB-Mannheim/tesseract/wiki. If tesseract.exe
# is not on PATH, point TESSERACT_CMD at it (restart the backend afterwards):
#   TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/macOS: `apt-get install tesseract-ocr` or `brew install tesseract`.
#
# Optional Tesseract language(s), e.g. eng, eng+hin. Defaults to eng.
# OCR_LANG=eng
