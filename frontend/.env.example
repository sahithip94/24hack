# Base URL of the FastAPI backend.
# In development the backend runs on http://localhost:8000.
# CORS on the backend already allows http://localhost:5173
# with the Authorization header, so the default works out of the box.
# In production, point this at your deployed API (or serve the
# frontend and API from the same origin and leave it empty).
VITE_API_BASE_URL=http://localhost:8001
