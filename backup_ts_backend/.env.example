# Backend configuration (copy to .env and adjust)
# Port the API listens on (default 8787)
PORT=8787

# Where MediVault persists its data (default: ./data/medivault.json)
# DATA_FILE=./data/medivault.json

# Where uploaded medical files are stored (default: ./data/uploads)
# UPLOADS_DIR=./data/uploads

# Max upload size in bytes (default: 10485760 = 10 MB)
# MAX_UPLOAD_BYTES=10485760

# Frontend origin, used for CORS and for building share/verification links
FRONTEND_URL=http://localhost:5173

# OPTIONAL - OpenAI-compatible AI provider for the AI Summary page.
# When unset, AI summaries run in a clearly-labelled demo mode built
# from record metadata only. When set, only record metadata
# (titles/categories/dates) is sent to the provider - never file contents.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# NODE_ENV=production  # enables secure cookies and static frontend serving
